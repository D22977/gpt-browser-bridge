{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash-free",
  "permission": {
    "external_directory": {
      "~/secrets/**": "deny",
      "C:/Users/Lupun/.ssh/**": "deny",
      "C:/Users/Lupun/AppData/Local/opencode/**": "deny",
      "*": "allow"
    },
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "git reset --hard *": "deny",
      "git clean *": "deny",
      "git stash *": "deny",
      "git push *": "deny",
      "rm -rf *": "deny",
      "*": "allow"
    }
  }
}
